# Application Configuration
APP_PORT=3000
NODE_ENV=development

# Database Configuration
# Options: sqlite, mysql, postgres
DB_TYPE=sqlite

# SQLite Configuration (when DB_TYPE=sqlite)
SQLITE_FILE=./data/store.db

# MySQL/PostgreSQL Configuration (when DB_TYPE=mysql or postgres)
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_NAME=storepos
# DB_USER=store
# DB_PASSWORD=change_me

# JWT Secret for Authentication
# Generate a secure random string for production
JWT_SECRET=change_this_to_a_secure_random_string_in_production

# Printer Configuration
PRINTER_NAME=
PRINT_QUEUE_CONCURRENCY=1
PRINT_MAX_RETRY=3
PRINT_RETRY_DELAY_MS=1500

# Supabase Configuration (optional - for cloud sync features)
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
