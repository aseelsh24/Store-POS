{
  "name": "POS",
  "version": "0.1.0",
  "description": "Store Point of Sale is a desktop application developed by Hosting Domain and available for free download at www.storepointofsale.com.",
  "author": "Hosting Domain",
  "private": true,
  "main": "start.js",
  "build": {
    "appId": "com.aseelsh.storepos",
    "productName": "Store POS",
    "directories": {
      "buildResources": "assets",
      "output": "dist"
    },
    "win": {
      "target": [
        "msi"
      ],
      "artifactName": "StorePOS-${version}.msi"
    }
  },
  "dependencies": {
    "async": "^2.6.4",
    "bcrypt": "^5.1.1",
    "body-parser": "^1.18.2",
    "dotenv": "^16.4.5",
    "electron": ">=22.3.25",
    "electron-context-menu": "^0.15.1",
    "electron-store": "^5.1.0",
    "electron-winstaller": "^4.0.0",
    "express": "^4.19.2",
    "express-fileupload": "^1.1.6",
    "express-rate-limit": "^7.4.2",
    "helmet": "^8.0.0",
    "html2canvas": "^1.0.0-rc.5",
    "http": "0.0.0",
    "https": "^1.0.0",
    "is-port-reachable": "^2.0.1",
    "jquery": "^3.4.1",
    "jsbarcode": "^3.11.0",
    "jspdf": "^2.3.1",
    "jsonwebtoken": "^9.0.2",
    "knex": "^3.1.0",
    "macaddress": "^0.2.9",
    "moment": "^2.29.4",
    "multer": "^1.4.5-lts.1",
    "mysql2": "^3.11.5",
    "nodemon": "^3.1.9",
    "path": "^0.12.7",
    "pg": "^8.13.1",
    "print-js": "^1.0.63",
    "socket.io": "^2.5.1",
    "sqlite3": "^5.1.7",
    "sweetalert2": "^11.14.5",
    "xmlhttprequest": "^1.8.0",
    "zod": "^3.24.1"
  },
  "scripts": {
    "electron": "cross-env NODE_ENV=dev nodemon --exec \"\"electron .\"\"",
    "electron-build": "electron-builder",
    "package-win": "electron-packager . POS --overwrite --asar=false --platform=win32 --arch=x64 --icon=assets/images/icon.ico --prune=true --out=release-builds --version-string.ProductName=\"POS\"",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "db:migrate": "knex migrate:latest",
    "db:rollback": "knex migrate:rollback",
    "db:seed": "knex seed:run",
    "dist:win": "electron-builder --win msi",
    "test": "jest",
    "build": "echo 'Build step placeholder'"
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "cross-env": "^7.0.3",
    "electron-builder": "^25.1.8",
    "electron-is-dev": "^3.0.1",
    "eslint": "^9.17.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-import": "^2.31.0",
    "jest": "^29.7.0",
    "nodemon": "^3.1.9",
    "prettier": "^3.4.2"
  }
}
